# Copy to .env at the Build_A_PC root. Existing api/load_env.sh loads this file.
# Shell-compatible syntax; never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/buildapc
DB_USER=buildapc
DB_PASSWORD=replace-with-your-local-db-password

# Separate GitHub OAuth Apps for Expo web and Expo Android.
GITHUB_WEB_CLIENT_ID=
GITHUB_WEB_CLIENT_SECRET=
GITHUB_WEB_REDIRECT_URI=http://localhost:8081/auth
GITHUB_ANDROID_CLIENT_ID=
GITHUB_ANDROID_CLIENT_SECRET=
GITHUB_ANDROID_REDIRECT_URI=client://auth

APP_JWT_ISSUER=http://localhost:8080
# Generate locally: openssl rand -base64 32
APP_JWT_SECRET_BASE64=
APP_JWT_TTL=PT1H
APP_CORS_ORIGINS=http://localhost:8081
