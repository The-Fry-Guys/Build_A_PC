# Copy to client/.env. EXPO_PUBLIC_* values are included in the app bundle.
# Public identifiers only: secrets and JWT signing keys belong on the API.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_GITHUB_WEB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_ANDROID_CLIENT_ID=
# Android emulator: use http://10.0.2.2:8080/api/v1 for the API URL.
# Physical device: use the development computer's reachable LAN address instead.
